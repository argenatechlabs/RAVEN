# RAVEN configuration — copy to .env and adjust.

# --- AI ---------------------------------------------------------------------
# auto = ilk yapilandirilan saglayici (OpenAI, Claude, Gemini, Grok, ...),
# ardindan Ollama erisilebilir ise Ollama, yoksa yerel analiz.
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
XAI_API_KEY=
XAI_MODEL=grok-3
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CUSTOM_API_KEY=
CUSTOM_MODEL=gpt-4o-mini
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1
# Not: API anahtarlari ayni zamanda arayuzdeki "API Anahtari / Model"
# penceresiyle veritabanina kaydedilebilir ve maskelenerek saklanir.

# --- Scanners ---------------------------------------------------------------
# Offline demonstration mode (sentetik hedef/bulgu). Production'da false.
DEMO_MODE=false
SCANNER_TIMEOUT=1200
# Backend container'ı başlarken 'alembic upgrade head' çalıştırır (başarısız olursa
# create_all yedeğiyle devam eder). Migration'ı atlamak için true yapın.
SKIP_MIGRATIONS=false
NUCLEI_SEVERITIES=critical,high,medium
# Tarayıcı binary'leri bu dizinde ya da PATH'te aranir.
SCANNER_BIN_DIR=/usr/local/bin
# Hedefe giden istek hizi (req/s) ve yerlesik motor sinirlari.
REQUEST_RATE_LIMIT=10
BUILTIN_MAX_HOSTS=15
BUILTIN_PARAM_BUDGET=40
# Ayni anda kac tarama calisabilir (SQLite icin 1 onerilir).
SCAN_CONCURRENCY=1
# Izinli tarama: oturum çerezi / özel başliklar (opsiyonel).
# SCAN_COOKIE=session=...
# SCAN_HEADERS={"X-Auth":"..."}

# --- API güvenliği ----------------------------------------------------------
# Boş = anahtarsiz (tek kullanici, yerel). Dolu ise X-API-Key/Bearer gerekir.
API_KEY=
API_RATE_LIMIT=true
API_RATE_LIMIT_RPM=120
SCAN_RATE_LIMIT_RPM=20
# Proxy arkasindaysa (X-Forwarded-For güvenilirse) true yapin.
TRUST_PROXY=false
CORS_ORIGINS=["*"]

# --- Infrastructure (compose already sets these) ----------------------------
DATABASE_URL=postgresql+psycopg2://raven:raven@postgres:5432/raven
REDIS_URL=redis://redis:6379/0
